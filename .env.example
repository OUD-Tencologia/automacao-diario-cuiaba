# Automacao Editorial - configuracao minima do MVP
# Copie para .env e preencha os valores. Nunca versione o .env.

# Aplicacao
APP_ENV=development
TZ=America/Sao_Paulo
LOG_LEVEL=INFO
AUTOMATION_API_HOST=127.0.0.1
AUTOMATION_API_PORT=8000
AUTOMATION_API_INTERNAL_URL=http://automation-api:8000
HEALTH_CHECK_TIMEOUT_SECONDS=5

# Folhapress
FOLHAPRESS_ENABLED=true
FOLHAPRESS_BASE_URL=https://folhapress.folha.com.br
FOLHAPRESS_LOGIN_URL=https://folhapress.folha.com.br/
FOLHAPRESS_TEXTS_URL=https://folhapress.folha.com.br/textos
FOLHAPRESS_USERNAME=
FOLHAPRESS_PASSWORD=
FOLHAPRESS_FILTER=TEXTOS
FOLHAPRESS_SERVICE_FILTER=SERVIÇO NOTICIOSO
FOLHAPRESS_ARTICLE_LINK_SELECTOR=a[href*="/texto/"]
FOLHAPRESS_PAGE_SIZE=24
FOLHAPRESS_CRON=0 * * * *
FOLHAPRESS_TIMEOUT_SECONDS=30
FOLHAPRESS_MAX_RETRIES=3
FOLHAPRESS_RETRY_BACKOFF_SECONDS=10
FOLHAPRESS_MAX_PAGES_PER_CYCLE=20
FOLHAPRESS_HEADLESS=true
FOLHAPRESS_USER_AGENT=AutomacaoEditorial/1.0

# PostgreSQL da VPS de homologacao
VPS_HOMOLOGATION_HOST=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD_URL_ENCODED@HOST:5432/DATABASE

# MinIO da VPS de homologacao
MINIO_ENDPOINT=http://HOST:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_BRONZE=bronze-raw
MINIO_REGION=us-east-1

# Resumo editorial local
SUMMARY_PROVIDER=sumy
SUMMARY_MAX_CHARACTERS=150

# Trinix: preparado, mas sem integracao ativa nesta fase
TRINIX_ADAPTER_MODE=disabled
