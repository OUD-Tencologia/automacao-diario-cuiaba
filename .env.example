# Automacao Editorial - template de configuracao
#
# Copie este arquivo para .env e preencha somente os valores vazios ou com
# CHANGE_ME. Nunca versione o .env.

# -----------------------------------------------------------------------------
# Projeto e aplicacao
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=automacao-editorial
APP_ENV=development
TZ=America/Sao_Paulo
LOG_LEVEL=INFO
AUTOMATION_API_HOST=0.0.0.0
AUTOMATION_API_PORT=8000
AUTOMATION_API_INTERNAL_URL=http://automation-api:8000
AUTOMATION_API_PUBLIC_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Folhapress - preencher apos validar o acesso e as URLs reais na PoC
# -----------------------------------------------------------------------------
FOLHAPRESS_ENABLED=true
FOLHAPRESS_BASE_URL=
FOLHAPRESS_LOGIN_URL=
FOLHAPRESS_TEXTS_URL=
FOLHAPRESS_USERNAME=
FOLHAPRESS_PASSWORD=
FOLHAPRESS_FILTER=TEXTOS
FOLHAPRESS_SERVICE_FILTER=SERVIÇO NOTICIOSO
# Seletores opcionais, preenchidos somente após a PoC de navegação.
FOLHAPRESS_LOGIN_USERNAME_SELECTOR=
FOLHAPRESS_LOGIN_PASSWORD_SELECTOR=
FOLHAPRESS_LOGIN_SUBMIT_SELECTOR=
FOLHAPRESS_SERVICE_FILTER_SELECTOR=
FOLHAPRESS_ARTICLE_LINK_SELECTOR=a[href*="/texto/"]
FOLHAPRESS_PAGE_SIZE=24
FOLHAPRESS_CRON=0 * * * *
FOLHAPRESS_TIMEOUT_SECONDS=30
FOLHAPRESS_MAX_RETRIES=3
FOLHAPRESS_RETRY_BACKOFF_SECONDS=10
FOLHAPRESS_MAX_PAGES_PER_CYCLE=20
FOLHAPRESS_HEADLESS=true
FOLHAPRESS_USER_AGENT=AutomacaoEditorial/1.0

# -----------------------------------------------------------------------------
# PostgreSQL - tabelas fisicas Bronze, Silver, Gold e operacional
# Gere uma senha longa e unica antes de subir qualquer ambiente compartilhado.
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=automacao_editorial
POSTGRES_USER=automacao_editorial
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://automacao_editorial:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/automacao_editorial

# -----------------------------------------------------------------------------
# MinIO / S3 - armazenamento imutavel dos TXT originais
# -----------------------------------------------------------------------------
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=automacao_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=automacao_minio
MINIO_SECRET_KEY=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_BUCKET_BRONZE=bronze-raw
MINIO_BUCKET_SILVER=silver-processed
MINIO_BUCKET_GOLD=gold-approved
MINIO_REGION=us-east-1

# -----------------------------------------------------------------------------
# n8n - orquestracao horaria, retry e reprocessamento
# Gere N8N_ENCRYPTION_KEY com: openssl rand -hex 32
# -----------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_SECURE_COOKIE=false

# -----------------------------------------------------------------------------
# Traefik e TLS - manter desativado ate existirem dominio e DNS
# -----------------------------------------------------------------------------
TRAEFIK_ENABLED=false
TRAEFIK_DOMAIN=
TRAEFIK_ACME_EMAIL=
TRAEFIK_DASHBOARD_ENABLED=false
TRAEFIK_DASHBOARD_AUTH=

# -----------------------------------------------------------------------------
# Observabilidade e alertas
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_SECRET_KEY=CHANGE_ME_GRAFANA_SECRET_KEY
PROMETHEUS_RETENTION_TIME=15d
ALERT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Backup e retencao
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
POSTGRES_BACKUP_RETENTION_DAYS=14
MINIO_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# VPS de homologacao - usada apenas pelos scripts de deploy; nao vai para os
# containers. Preencha quando o IP/host estiver definido.
# -----------------------------------------------------------------------------
DEPLOY_ENV=homologation
VPS_HOMOLOGATION_HOST=
VPS_HOMOLOGATION_PORT=22
VPS_HOMOLOGATION_USER=diariocuiaba
VPS_HOMOLOGATION_PATH=/opt/automacao-editorial
VPS_HOMOLOGATION_SSH_KEY_PATH=~/.ssh/id_ed25519

# VPS de producao - pendencia, manter vazia ate a definicao do ambiente.
VPS_PRODUCTION_HOST=
VPS_PRODUCTION_PORT=22
VPS_PRODUCTION_USER=
VPS_PRODUCTION_PATH=/opt/automacao-editorial
VPS_PRODUCTION_SSH_KEY_PATH=

# -----------------------------------------------------------------------------
# Proxmox / Terraform - usar somente se a VPS for provisionada via IaC.
# -----------------------------------------------------------------------------
PROXMOX_ENDPOINT=
PROXMOX_API_TOKEN=
PROXMOX_NODE=pve
PROXMOX_TEMPLATE_VM_ID=
PROXMOX_SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub

# -----------------------------------------------------------------------------
# Trinix - sem acesso nesta fase; o adaptador inicia em modo simulado.
# -----------------------------------------------------------------------------
TRINIX_ADAPTER_MODE=mock
TRINIX_BASE_URL=
TRINIX_API_KEY=
TRINIX_TIMEOUT_SECONDS=30

# Futuro: somente quando houver decisao de usar Vault como backend de segredos.
SECRETS_BACKEND=docker_env
VAULT_ADDR=
VAULT_TOKEN=
